<Window x:Class="NativeTavern.Views.CharacterGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建分组" Width="560" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" PreviewKeyDown="Dialog_OnPreviewKeyDown" Loaded="Dialog_OnLoaded" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="18">
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
          CornerRadius="16" Padding="26,24,26,22">
   <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.20" Color="#32000000"/></Border.Effect>
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Width="48" Height="2" CornerRadius="1" Background="{DynamicResource TealBrush}" HorizontalAlignment="Left"/>
    <TextBlock x:Name="DialogTitle" Grid.Row="1" Margin="0,17,0,0" FontFamily="Georgia, Cambria, SimSun" FontSize="23" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="2" Margin="0,20,0,0">
     <TextBlock x:Name="NameLabel" Text="分组名称" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBox x:Name="GroupNameBox" MaxLength="80"/>
     <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource DangerTextBrush}" FontSize="12" Margin="2,7,0,0"/>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,19,0,9">
     <TextBlock x:Name="SelectionLabel" Text="选择该分组包含的角色" FontWeight="SemiBold"/>
     <TextBlock x:Name="SelectionCount" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
    <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
     <ListBox x:Name="CharacterList" Background="Transparent" BorderThickness="0"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Selection_OnChanged" Unchecked="Selection_OnChanged"
                 Padding="10,8" HorizontalContentAlignment="Stretch">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding Character.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Character.Tags}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                     Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding Character.GroupName}" Foreground="{DynamicResource SubtleTextBrush}"
                    FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
       </CheckBox>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Border>
    <StackPanel Grid.Row="5" Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="取消" MinWidth="92" Padding="18,10" Margin="0" IsCancel="True" Click="Cancel_OnClick"/>
     <Button x:Name="SaveButton" Content="创建分组" MinWidth="108" Padding="18,10" Margin="10,0,0,0"
             Style="{StaticResource PrimaryButtonStyle}" Click="Save_OnClick"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
