<UserControl x:Class="NativeTavern.Views.PromptStudioView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="FormLabelStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Margin" Value="2,0,0,7"/>
  </Style>
  <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource DangerSoftBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBorderBrush}"/>
  </Style>
  <Style x:Key="SelectionRequiredDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerOutlineButtonStyle}">
   <Style.Triggers>
    <Trigger Property="Tag" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></Trigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="StudioResourceTemplate">
   <Grid Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>

 <Grid Background="Transparent" Margin="30,26,30,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource TealBrush}" BorderThickness="2,0,0,0" Padding="15,0,0,0" Margin="0,0,18,0">
   <StackPanel>
    <TextBlock Text="CREATIVE TOOLKIT" Style="{StaticResource PageKickerStyle}" Margin="0,0,0,5"/>
    <TextBlock Text="Prompt Studio" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="Manage personas, lorebooks and prompt presets used to shape each conversation."
               Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0"/>
   </StackPanel>
   </Border>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Import…" Click="ImportResources_OnClick"
            ToolTip="Import a resource pack or a SillyTavern world info file" Margin="0,0,10,0"/>
    <Button Content="Export all" Click="ExportResources_OnClick"
            ToolTip="Save personas, lorebooks, presets and scripts to one JSON file"/>
   </StackPanel>
  </Grid>

  <TabControl Grid.Row="1" Style="{StaticResource StudioTabControlStyle}">
   <TabItem Header="Personas" Style="{StaticResource StudioTabItemStyle}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource SurfaceBorderStyle}" Padding="14">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="4,2,4,14"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}"><TextBlock Text="{Binding Personas.Count}" FontSize="11" Foreground="{DynamicResource AccentTintTextBrush}"/></Border><TextBlock Text="Personas" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Choose a voice for your conversations" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
       <Grid Grid.Row="1">
        <ListBox x:Name="PersonaList" ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" ItemTemplate="{StaticResource StudioResourceTemplate}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=PersonaList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="No personas yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
         <TextBlock Text="Create one to define a reusable voice." Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
       </Grid>
       <Button Grid.Row="2" Content="+  New persona" Command="{Binding NewPersonaCommand}" Margin="0,12,0,0" HorizontalContentAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="24">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,18"><DockPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="24" Margin="0,0,13,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Persona details" FontFamily="Georgia, Cambria, SimSun" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Define how this persona speaks and behaves." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
       <StackPanel Grid.Row="1"><TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PersonaName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/></StackPanel>
       <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Persona content" Style="{StaticResource FormLabelStyle}"/><TextBox Grid.Row="1" Text="{Binding PersonaContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180"/></Grid>
       <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Delete" Click="DeletePersona_OnClick" Style="{StaticResource SelectionRequiredDangerButtonStyle}" Tag="{Binding SelectedPersona}"/>
        <Button Content="Save persona" Command="{Binding SavePersonaCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="Lorebooks" Style="{StaticResource StudioTabItemStyle}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="14"/><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource SurfaceBorderStyle}" Padding="12">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="4,2,4,14"><Border DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}"><TextBlock Text="{Binding Lorebooks.Count}" FontSize="11" Foreground="{DynamicResource AccentTintTextBrush}"/></Border><TextBlock Text="Lorebooks" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel>
       <Grid Grid.Row="1">
        <ListBox x:Name="LorebookList" ItemsSource="{Binding Lorebooks}" SelectedItem="{Binding SelectedLorebook}" ItemTemplate="{StaticResource StudioResourceTemplate}"/>
        <TextBlock Text="No lorebooks yet" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitleStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=LorebookList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <Button Grid.Row="2" Content="+  New lorebook" Command="{Binding NewLorebookCommand}" Margin="0,12,0,0" HorizontalContentAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="18">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Border Background="{DynamicResource TealTintBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"><DockPanel><TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource TealTintTextBrush}" FontSize="19" Margin="0,0,10,0"/><TextBlock Text="Lorebook settings" FontFamily="Georgia, Cambria, SimSun" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TealTintTextBrush}"/></DockPanel></Border>
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
         <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding LorebookName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
         <TextBlock Text="Description" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding LorebookDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="78"/>
         <CheckBox Content="Enabled" IsChecked="{Binding LorebookEnabled}" Margin="2,16,0,14"/>
         <TextBlock Text="Entries" FontWeight="SemiBold"/>
         <Grid Margin="0,8,0,0" MinHeight="84">
          <ListBox x:Name="LoreEntryList" ItemsSource="{Binding LoreEntries}" SelectedItem="{Binding SelectedLoreEntry}" DisplayMemberPath="Name" MinHeight="84" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock Text="No entries yet" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitleStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=LoreEntryList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
         </Grid>
         <Button Content="+  New entry" Command="{Binding NewLoreEntryCommand}" Margin="0,10,0,4" HorizontalContentAlignment="Center"/>
        </StackPanel>
       </ScrollViewer>
       <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Delete" Click="DeleteLorebook_OnClick" Style="{StaticResource SelectionRequiredDangerButtonStyle}" Tag="{Binding SelectedLorebook}"/><Button Content="Save" Command="{Binding SaveLorebookCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="4" Style="{StaticResource SurfaceBorderStyle}" Padding="20">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16"><TextBlock Text="Entry details" FontFamily="Georgia, Cambria, SimSun" FontSize="16" FontWeight="SemiBold"/></Border>
       <TextBlock Text="Entry name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntryName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13"/>
       <TextBlock Text="Primary keywords" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntryKeywords,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13" ToolTip="Comma separated"/>
       <TextBlock Text="Secondary keywords" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntrySecondaryKeywords,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,13"/>
       <TextBlock Text="Content" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntryContent,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" Margin="0,0,0,13"/>
       <WrapPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="Priority" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntryPriority}" Width="75"/></StackPanel><StackPanel><TextBlock Text="Depth" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding EntryDepth}" Width="75"/></StackPanel></WrapPanel>
       <WrapPanel Margin="0,16,0,14"><CheckBox Content="Enabled" IsChecked="{Binding EntryEnabled}" Margin="0,0,16,0"/><CheckBox Content="Constant" IsChecked="{Binding EntryConstant}" Margin="0,0,16,0"/><CheckBox Content="Selective" IsChecked="{Binding EntrySelective}"/></WrapPanel>
       <WrapPanel HorizontalAlignment="Right"><Button Content="Delete entry" Click="DeleteLoreEntry_OnClick" Style="{StaticResource SelectionRequiredDangerButtonStyle}" Tag="{Binding SelectedLoreEntry}" Margin="0,0,8,6"/><Button Content="Save entry" Command="{Binding SaveLoreEntryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,6"/></WrapPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="Prompt presets" Style="{StaticResource StudioTabItemStyle}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource SurfaceBorderStyle}" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="4,2,4,14"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}"><TextBlock Text="{Binding Presets.Count}" FontSize="11" Foreground="{DynamicResource AccentTintTextBrush}"/></Border><TextBlock Text="Prompt presets" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Reusable model instructions" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/></StackPanel>
       <Grid Grid.Row="1">
        <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" ItemTemplate="{StaticResource StudioResourceTemplate}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=PresetList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="No presets yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
         <TextBlock Text="Create one to reuse model instructions." Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
       </Grid>
       <Button Grid.Row="2" Content="+  New preset" Command="{Binding NewPresetCommand}" Margin="0,12,0,0" HorizontalContentAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <Border Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,18"><DockPanel><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="24" Margin="0,0,13,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Preset details" FontFamily="Georgia, Cambria, SimSun" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Configure instructions and optional model overrides." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
       <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PresetName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
       <TextBlock Text="System prompt" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding SystemPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Margin="0,0,0,14"/>
       <TextBlock Text="Main prompt" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding MainPrompt,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" Margin="0,0,0,14"/>
       <TextBlock Text="Model override" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PresetModel,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
       <WrapPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="Temperature" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PresetTemperature}" Width="90"/></StackPanel><StackPanel Margin="0,0,18,0"><TextBlock Text="Top P" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PresetTopP}" Width="90"/></StackPanel><StackPanel><TextBlock Text="Max tokens" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding PresetMaxTokens}" Width="110"/></StackPanel></WrapPanel>
       <TextBlock Text="Leave overrides blank to use the values from Settings." Style="{StaticResource PageSubtitleStyle}" Margin="0,12,0,18"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Delete" Click="DeletePreset_OnClick" Style="{StaticResource SelectionRequiredDangerButtonStyle}" Tag="{Binding SelectedPreset}"/><Button Content="Save preset" Command="{Binding SavePresetCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/></StackPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Regex scripts" Style="{StaticResource StudioTabItemStyle}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource SurfaceBorderStyle}" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="4,2,4,14"><DockPanel><Border DockPanel.Dock="Right" Style="{StaticResource CountBadgeStyle}"><TextBlock Text="{Binding RegexScripts.Count}" FontSize="11" Foreground="{DynamicResource AccentTintTextBrush}"/></Border><TextBlock Text="Regex scripts" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Clean up text as it is written" Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0"/></StackPanel>
       <Grid Grid.Row="1">
        <ListBox x:Name="ScriptList" ItemsSource="{Binding RegexScripts}" SelectedItem="{Binding SelectedRegexScript}" ItemTemplate="{StaticResource StudioResourceTemplate}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ScriptList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
         <TextBlock Text="No scripts yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
         <TextBlock Text="Replace recurring wording in replies or in your own input." Style="{StaticResource PageSubtitleStyle}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
       </Grid>
       <Button Grid.Row="2" Content="+  New script" Command="{Binding NewRegexScriptCommand}" Margin="0,12,0,0" HorizontalContentAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="22">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
       <Border Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="14,12" Margin="0,0,0,18"><DockPanel><TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="24" Margin="0,0,13,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Script details" FontFamily="Georgia, Cambria, SimSun" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applied in list order, and saved with the script." Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
       <TextBlock Text="Name" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ScriptName,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
       <TextBlock Text="Find" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ScriptPattern,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
       <TextBlock Text="{Binding ScriptPatternError}" Foreground="{DynamicResource DangerTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding ScriptPatternError, Converter={StaticResource StringToVisibility}}"/>
       <TextBlock Text="Replace with" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ScriptReplacement,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
       <WrapPanel>
        <StackPanel Margin="0,0,18,0"><TextBlock Text="Applies to" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ScriptTargets}" SelectedItem="{Binding ScriptTarget}" Width="170" DisplayMemberPath="." Margin="0,0,0,14"/></StackPanel>
        <StackPanel Margin="0,0,18,0"><TextBlock Text="Match" Style="{StaticResource FormLabelStyle}"/><ComboBox ItemsSource="{Binding ScriptModes}" SelectedItem="{Binding ScriptMode}" Width="170" DisplayMemberPath="." Margin="0,0,0,14"/></StackPanel>
        <StackPanel><CheckBox Content="Enabled" IsChecked="{Binding ScriptEnabled}" Margin="2,22,0,0"/></StackPanel>
       </WrapPanel>
       <TextBlock Text="Regular expressions ignore letter case. Use $1, $2 in the replacement to keep captured text." Style="{StaticResource PageSubtitleStyle}" Margin="0,2,0,14"/>
       <TextBlock Text="Try it on sample text" Style="{StaticResource FormLabelStyle}"/><TextBox Text="{Binding ScriptTest,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,0,0,8"/>
       <Border Background="{DynamicResource NeutralBgBrush}" CornerRadius="8" Padding="11,9" MinHeight="40">
        <TextBlock Text="{Binding ScriptPreview}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
       </Border>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Delete" Command="{Binding DeleteSelectedRegexScriptCommand}" Style="{StaticResource SelectionRequiredDangerButtonStyle}" Tag="{Binding SelectedRegexScript}"/><Button Content="Save script" Command="{Binding SaveRegexScriptCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/></StackPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" Margin="2,12,0,0"/>
 </Grid>
</UserControl>
