<Window x:Class="NativeTavern.Views.GroupPerformanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="群聊自动演出" Width="510" Height="590" MinWidth="430" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <Border Background="{DynamicResource TealTintBgBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                <TextBlock Text="Group performance" Foreground="{DynamicResource TealTintTextBrush}" FontSize="10" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Let the story unfold" FontFamily="Georgia, Cambria, SimSun" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label x:Name="RoundsLabel" Target="{Binding ElementName=RoundsBox}" Content="演出轮数"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <ComboBox x:Name="RoundsBox" Grid.Column="1" MinWidth="110" HorizontalAlignment="Left"
                      AutomationProperties.Name="演出轮数"/>
        </Grid>
        <Label x:Name="OrderLabel" Grid.Row="2" Target="{Binding ElementName=SpeakerList}"
               Content="发言顺序" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <ListBox x:Name="SpeakerList" DisplayMemberPath="Name" SelectionMode="Single"
                         Background="Transparent" BorderThickness="0" AutomationProperties.Name="角色发言顺序"
                         SelectionChanged="SpeakerList_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="MoveUpButton" Content="上移" IsEnabled="False" MinWidth="80" Margin="0,0,0,8"
                        Click="MoveUp_OnClick" AutomationProperties.Name="将选中角色上移"/>
                <Button x:Name="MoveDownButton" Content="下移" IsEnabled="False" MinWidth="80" Margin="0"
                        Click="MoveDown_OnClick" AutomationProperties.Name="将选中角色下移"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ValidationMessage" Grid.Row="4" Foreground="{DynamicResource DangerTextBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="84" Margin="0,0,10,0"/>
            <Button x:Name="StartButton" Content="开始演出" IsDefault="True" MinWidth="105" Margin="0"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Start_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
