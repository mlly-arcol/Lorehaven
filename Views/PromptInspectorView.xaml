<UserControl x:Class="NativeTavern.Views.PromptInspectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0"/>
   <Border BorderBrush="{DynamicResource TealBrush}" BorderThickness="2,0,0,0" Padding="15,0,0,0" Margin="0,0,18,0">
    <StackPanel><TextBlock Text="Prompt Inspector" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Inspect the exact text context before sending it to your Provider." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
   </Border>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14">
   <Border Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Estimated tokens: " Foreground="{DynamicResource AccentTintTextBrush}"/><TextBlock Text="{Binding EstimatedTokens}" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><TextBlock Text="Lore: "/><TextBlock Text="{Binding ActivatedLore}" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="History: "/><TextBlock Text="{Binding HistoryBudget}" FontWeight="SemiBold"/></StackPanel></Border>
  </WrapPanel>
  <Border Grid.Row="2" Style="{StaticResource SurfaceBorderStyle}" Padding="18">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,13">
     <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE943;" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
     <TextBlock Text="Assembled context" Style="{StaticResource SectionTitleStyle}"/>
    </DockPanel>
    <TextBox Grid.Row="1" Text="{Binding PromptText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas" FontSize="12" Background="{DynamicResource WindowBrush}" Padding="16"/>
   </Grid>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0"/>
 </Grid>
</UserControl>
