<Window x:Class="NativeTavern.Views.CharacterMemoryDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="角色记忆" Width="700" Height="700" MinWidth="560" MinHeight="540"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False" Loaded="Dialog_OnLoaded" Closing="Dialog_OnClosing">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <Border Background="{DynamicResource TealTintBgBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
    <TextBlock Text="Long-term memory" Foreground="{DynamicResource TealTintTextBrush}" FontSize="10" FontWeight="SemiBold"/>
   </Border>
   <TextBlock x:Name="HeadingText" Text="角色记忆" FontFamily="Georgia, Cambria, SimSun" FontSize="25" FontWeight="SemiBold"/>
   <TextBlock x:Name="IntroText" Text="记忆跟随角色跨对话保存。锁定的重要事实不会被自动整理替换或清除。"
    Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <TextBlock x:Name="CharacterLabel" Text="记忆所属角色" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <ComboBox x:Name="CharacterPicker" DisplayMemberPath="Name" MinWidth="180"
    AutomationProperties.Name="选择记忆所属角色" SelectionChanged="Character_OnSelectionChanged"/>
  </DockPanel>
  <ListBox x:Name="MemoryList" Grid.Row="2" SelectionChanged="Memory_OnSelectionChanged"
   Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8"
   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="角色记忆列表">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="Padding" Value="8"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="MemoryBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="4" Padding="{TemplateBinding Padding}">
         <ContentPresenter HorizontalAlignment="Stretch"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MemoryBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="MemoryBorder" Property="Background" Value="{DynamicResource AccentTintBgBrush}"/><Setter TargetName="MemoryBorder" Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid Margin="5,7">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TealTintTextBrush}" VerticalAlignment="Top" Margin="0,3,0,0">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Text" Value="&#xE8A5;"/>
         <Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True">
          <Setter Property="Text" Value="&#xE72E;"/>
          <Setter Property="ToolTip" Value="{Binding LockedMemoryTooltip, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
         </DataTrigger></Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap"/>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Margin="0,16,0,0">
   <DockPanel Margin="0,0,0,8">
    <TextBlock x:Name="EditorLabel" Text="新增记忆" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="CountText" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right"/>
   </DockPanel>
   <TextBox x:Name="ContentBox" MinHeight="88" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap"
    MaxLength="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="记忆内容，最多 200 字"/>
   <CheckBox x:Name="LockedBox" Content="锁定重要记忆" Foreground="{DynamicResource TextBrush}" IsChecked="True" Margin="0,10,0,0"
    ToolTip="自动整理不会清除锁定的记忆，您仍可手动编辑或删除。"/>
  </StackPanel>
  <TextBlock x:Name="StatusText" Grid.Row="4" MinHeight="22" Margin="0,10,0,6"
   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <DockPanel Grid.Row="5">
   <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="完成" IsCancel="True" Margin="12,0,0,0"/>
   <StackPanel x:Name="ActionButtons" Orientation="Horizontal">
    <Button x:Name="NewButton" Content="新增" Click="New_OnClick"/>
    <Button x:Name="SaveButton" Content="保存记忆" Click="Save_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
    <Button x:Name="DeleteButton" Content="删除" IsEnabled="False" Click="Delete_OnClick"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
