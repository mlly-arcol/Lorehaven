<UserControl x:Class="NativeTavern.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:NativeTavern.Controls"
 xmlns:models="clr-namespace:NativeTavern.Models">
 <UserControl.Resources>
  <Style x:Key="MessageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="ConversationIconStyle" TargetType="Button" BasedOn="{StaticResource RoundIconButtonStyle}">
   <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="ContentTemplate">
    <Setter.Value>
     <DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="ChatLayout" Background="{DynamicResource WindowBrush}" SizeChanged="ChatLayout_OnSizeChanged">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="NotesColumn" Width="270"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>


  <Border x:Name="ConversationHeader" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0" Margin="8,10,8,0" Background="{DynamicResource PanelBrush}" ClipToBounds="True">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Image x:Name="HeaderArtwork" Source="{DynamicResource ThemeHeaderArtwork}" Stretch="UniformToFill" HorizontalAlignment="Right" Width="600" Height="210" Opacity="{DynamicResource ThemeHeaderOpacity}" IsHitTestVisible="False">
      <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00000000"/><GradientStop Offset="0.28" Color="#88000000"/><GradientStop Offset="0.60" Color="#FF000000"/></LinearGradientBrush></Image.OpacityMask>
     </Image>
     <Grid Margin="26,20,20,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,0">
        <TextBlock x:Name="ConversationKicker" Text="STORY WORKSPACE" FontSize="10" Foreground="{DynamicResource ClayTintTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <DockPanel>
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
          <Button Content="&#xE70F;" Click="RenameChat_OnClick" Style="{StaticResource ConversationIconStyle}" Width="28" Height="28" Background="Transparent" ToolTip="Rename conversation" AutomationProperties.Name="Rename conversation"/>
          <Button Content="&#xE734;" Command="{Binding GenerateConversationTitleCommand}" Style="{StaticResource ConversationIconStyle}" Width="28" Height="28" Background="Transparent" ToolTip="Generate a title from recent messages" AutomationProperties.Name="Generate conversation title"/>
          <Button Content="&#xE711;" Command="{Binding CancelConversationTitleCommand}" Style="{StaticResource ConversationIconStyle}" Width="28" Height="28" Background="Transparent" Visibility="{Binding IsGeneratingTitle, Converter={StaticResource BoolToVisibility}}" ToolTip="Cancel title generation"/>
         </StackPanel>
         <TextBlock x:Name="StoryTitleText" Text="{Binding SessionTitle}" FontFamily="{DynamicResource JournalTitleFontFamily}" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionTitle}"/>
        </DockPanel>
        <TextBlock x:Name="StoryDescription" Text="{Binding JournalDescription}" TextWrapping="Wrap" MaxHeight="44" LineHeight="21" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="1,8,100,0" Visibility="{Binding JournalDescription, Converter={StaticResource StringToVisibility}}"/>
        <StackPanel Orientation="Horizontal" Margin="1,7,0,0">
         <TextBlock Text="Local workspace" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
         <Button Content="返回源对话" Command="{Binding OpenParentConversationCommand}" Style="{StaticResource GhostButtonStyle}" Padding="6,0" Margin="8,0,0,0" FontSize="10" Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisibility}}"/>
         <TextBlock Text="Generating title…" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" Visibility="{Binding IsGeneratingTitle, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="NotesToggleButton" Content="&#xE8F1;" Click="ToggleNotes_OnClick" Style="{StaticResource ConversationIconStyle}" Margin="0,0,5,0" ToolTip="Story notes" AutomationProperties.Name="Story notes"/>
        <Button Content="&#xE713;" Click="PromptSettings_OnClick" Style="{StaticResource ConversationIconStyle}" Margin="0,0,5,0" ToolTip="对话设置"/>
        <Button Content="&#xE712;" Click="ConversationMore_OnClick" Style="{StaticResource ConversationIconStyle}" ToolTip="更多操作">
         <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="查看提示词" Command="{Binding OpenPromptInspectorCommand}"/>
          <MenuItem Header="插件提示词资源…" Click="PluginResources_OnClick"/>
          <MenuItem Header="掷骰与随机表…" Click="DiceRandom_OnClick"/>
          <MenuItem Header="剧情事件时间线…" Click="StoryTimeline_OnClick"/>
          <MenuItem Header="导出对话…" Click="ExportChat_OnClick"/>
          <MenuItem Header="Pin this conversation" Command="{Binding ToggleSessionPinCommand}"/>
          <Separator/><MenuItem Header="删除对话…" Click="DeleteChat_OnClick"/>
         </ContextMenu></Button.ContextMenu>
        </Button>
       </StackPanel>
      </Grid>
      <WrapPanel Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Center">
       <ItemsControl ItemsSource="{Binding MemoryCharacters}" Margin="0,0,12,3" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" Margin="0,0,16,3" VerticalAlignment="Center">
          <Border CornerRadius="24" BorderBrush="{DynamicResource TealTintBorderBrush}" BorderThickness="1" Padding="3" Width="45" Height="45">
           <Grid><Ellipse Fill="{DynamicResource TealTintBgBrush}"/><TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TealTintTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse Visibility="{Binding AvatarPath, Converter={StaticResource StringToVisibility}}"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
           </Grid>
          </Border>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="Start performance…" Click="GroupPerformance_OnClick" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanConfigureGroupPerformance}" Margin="0,0,7,4" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
       <Button Content="Story branches" Click="ConversationBranches_OnClick" Margin="0,0,7,4"/>
       <Button Content="&#xE721;" Click="ToggleTools_OnClick" Style="{StaticResource ConversationIconStyle}" Margin="0,0,0,4" ToolTip="Search messages" AutomationProperties.Name="Search messages"/>
      </WrapPanel>
     </Grid>
    </Grid>
    <Expander x:Name="ConversationTools" Grid.Row="1" Header="Conversation tools" Margin="20,0,20,10" FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
     <ScrollViewer MaxHeight="225" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,8,0,0">
       <WrapPanel Margin="0,0,0,4">
        <Button Content="成员" Click="EditGroupChat_OnClick" FontSize="11" Margin="0,0,6,4" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="下一位 ▾" Click="NextSpeaker_OnClick" FontSize="11" Margin="0,0,6,4" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="插件资源" Click="PluginResources_OnClick" FontSize="11" Margin="0,0,6,4"/>
        <Button Content="掷骰" Click="DiceRandom_OnClick" FontSize="11" Margin="0,0,6,4"/>
        <Button Content="事件时间线" Click="StoryTimeline_OnClick" FontSize="11" Margin="0,0,6,4"/>
       </WrapPanel>
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" VerticalAlignment="Center" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,8,0" Command="{Binding ToggleSessionPinCommand}"
              ToolTip="Pin this conversation" AutomationProperties.Name="Pin conversation">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource ConversationIconStyle}">
            <Setter Property="Opacity" Value="0.45"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="100" Height="36" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                DisplayMemberPath="PickerText" Margin="0,0,8,0" ToolTip="Switch conversation" AutomationProperties.Name="Switch conversation">
        <ComboBox.ItemContainerStyle>
          <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding PickerLabel}"/>
          </Style>
        </ComboBox.ItemContainerStyle>
      </ComboBox>
      <Grid Grid.Column="2" Height="36" Margin="0,0,12,0">
      <TextBox x:Name="ConversationSearchBox" VerticalContentAlignment="Center"
               Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_OnKeyDown"
               ToolTip="Search messages · Enter to search" AutomationProperties.Name="Search conversations" AutomationProperties.HelpText="Enter a keyword, or choose a filter to browse recent messages"/>
      <TextBlock Text="Search messages" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" IsHitTestVisible="False"
                 VerticalAlignment="Center" Margin="9,1,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      </Grid>
      <Popup PlacementTarget="{Binding ElementName=ConversationSearchBox}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="0"
             IsOpen="{Binding IsSearchOpen}" StaysOpen="False" Closed="SearchPopup_OnClosed">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="6" MinWidth="420" MaxWidth="480" Margin="0,4,0,0">
          <StackPanel>
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Style="{StaticResource GhostButtonStyle}" MaxWidth="460" HorizontalContentAlignment="Stretch"
                          Padding="10,8" Margin="0,1" ToolTip="{Binding Snippet}"
                          AutomationProperties.Name="{Binding Label}"
                          Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}" Margin="10,0,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                      <TextBlock Text="{Binding Speaker}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10"
                                 Margin="0,1,0,0" Visibility="{Binding Speaker, Converter={StaticResource StringToVisibility}}"/>
                      <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                 TextWrapping="Wrap" MaxHeight="42" LineHeight="16"/>
                    </StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Searching messages…" Foreground="{DynamicResource MutedTextBrush}" Margin="10,8"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Search failed. Please try again." Foreground="{DynamicResource MutedTextBrush}" Margin="10,8"
                       Visibility="{Binding HasSearchError, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="No matching messages" Foreground="{DynamicResource MutedTextBrush}" Margin="10,8"
                       Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="Showing up to 30 recent matches" Foreground="{DynamicResource SubtleTextBrush}" Margin="10,8" FontSize="10"
                       Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </Border>
      </Popup>
     <StackPanel Grid.Column="3" Orientation="Horizontal">
     <Button x:Name="PinnedListButton" Content="&#xE734;" Style="{StaticResource ConversationIconStyle}" Margin="0,0,8,0"
             Command="{Binding OpenPinnedListCommand}" IsEnabled="{Binding HasPinnedMessages}"
             ToolTip="Pinned messages" AutomationProperties.Name="Pinned messages"/>
      <Popup PlacementTarget="{Binding ElementName=PinnedListButton}" Placement="Bottom" AllowsTransparency="True"
             IsOpen="{Binding IsPinnedListOpen}" StaysOpen="False" Closed="PinnedPopup_OnClosed">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="6" MinWidth="380" MaxWidth="460" Margin="0,4,0,0">
          <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PinnedMessages}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource GhostButtonStyle}" MaxWidth="440" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,1" AutomationProperties.Name="{Binding EntryLabel}"
                        Command="{Binding DataContext.JumpToPinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Content}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               TextWrapping="Wrap" MaxHeight="42" LineHeight="16"/>
                  </StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
     <Button x:Name="StorySummaryButton" Content="&#xE8A5;" Style="{StaticResource ConversationIconStyle}" Margin="0,0,8,0"
             Command="{Binding OpenStorySummaryCommand}" ToolTip="Story summary" AutomationProperties.Name="Story summary"/>
      <Popup PlacementTarget="{Binding ElementName=StorySummaryButton}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="-300"
             IsOpen="{Binding IsStorySummaryOpen}" StaysOpen="False" Closed="StorySummaryPopup_OnClosed">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12" Width="440" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock Text="剧情回顾" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="{Binding StorySummaryCoverage}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,8"/>
            <TextBox Height="190" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="12" Text="{Binding StorySummary, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Story summary text"
                     ToolTip="这段回顾会随每次请求发送给模型，可直接修改"/>
            <TextBlock Text="{Binding StorySummaryStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="清空" Command="{Binding ClearStorySummaryCommand}"/>
              <Button Content="重新生成" Command="{Binding RebuildStorySummaryCommand}" Margin="8,0,0,0"/>
              <Button Content="保存回顾" Command="{Binding SaveStorySummaryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>
     <Button x:Name="MemoryButton" Content="&#xE8F1;" Style="{StaticResource ConversationIconStyle}" Margin="0,0,8,0"
             Command="{Binding OpenMemoryCommand}" ToolTip="Character memory" AutomationProperties.Name="Character memory"
             Visibility="{Binding HasMemoryTarget, Converter={StaticResource BoolToVisibility}}"/>
     <Popup PlacementTarget="{Binding ElementName=MemoryButton}" Placement="Bottom" AllowsTransparency="True"
            HorizontalOffset="-300"
            IsOpen="{Binding IsMemoryOpen}" StaysOpen="False" Closed="MemoryPopup_OnClosed">
       <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
               CornerRadius="10" Padding="12" Width="440" Margin="0,4,0,0">
         <StackPanel>
           <TextBlock Text="角色记忆" FontWeight="SemiBold" FontSize="13"/>
           <ComboBox ItemsSource="{Binding MemoryCharacters}" SelectedItem="{Binding SelectedMemoryCharacter}" DisplayMemberPath="Name"
                     Margin="0,8,0,0" Height="34" AutomationProperties.Name="Memory character"
                     Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
           <TextBlock Text="角色长期记住的要点，会随每次请求发送；在设置中开启后自动提炼" Foreground="{DynamicResource SubtleTextBrush}"
                      FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
           <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
             <ItemsControl ItemsSource="{Binding CharacterMemories}">
               <ItemsControl.ItemTemplate><DataTemplate>
                 <Grid Margin="0,2">
                   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                   <StackPanel>
                     <TextBlock Text="🔒" FontSize="11" ToolTip="Locked memory" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/>
                     <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                   </StackPanel>
                   <Button Grid.Column="1" Content="×" Style="{StaticResource GhostButtonStyle}" Padding="6,0" Margin="8,0,0,0"
                           Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}" ToolTip="删除这条记忆" AutomationProperties.Name="Delete memory"/>
                 </Grid>
               </DataTemplate></ItemsControl.ItemTemplate>
             </ItemsControl>
           </ScrollViewer>
           <TextBlock Text="No memories yet" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="2,6"
                      Visibility="{Binding HasMemories, Converter={StaticResource InverseBoolToVisibility}}"/>
           <TextBox Height="36" Margin="0,10,0,0" Text="{Binding NewMemoryText, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" ToolTip="Add a memory manually" AutomationProperties.Name="New memory"/>
           <TextBlock Text="{Binding MemoryStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                      TextWrapping="Wrap" Margin="0,6,0,0"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
             <Button Content="Edit / lock memories" Click="ManageMemories_OnClick" Margin="0,0,8,0"/>
             <Button Content="立即提炼" Command="{Binding ExtractMemoryNowCommand}" IsEnabled="{Binding CanExtractMemory}"/>
             <Button Content="添加" Command="{Binding AddMemoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
           </StackPanel>
         </StackPanel>
       </Border>
     </Popup>
     <Button x:Name="StatsButton" Content="&#xE9D9;" Style="{StaticResource ConversationIconStyle}" Margin="0,0,8,0"
             Command="{Binding OpenStatsCommand}" ToolTip="Conversation stats" AutomationProperties.Name="Conversation stats"/>
      <Popup PlacementTarget="{Binding ElementName=StatsButton}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="-300"
             IsOpen="{Binding IsStatsOpen}" StaysOpen="False">
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14" Width="360" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock Text="对话统计" FontWeight="SemiBold" FontSize="13"/>
            <ItemsControl ItemsSource="{Binding StatLines}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="发言占比" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,2"
                       Visibility="{Binding HasSpeakerShares, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding SpeakerShares}"
                          Visibility="{Binding HasSpeakerShares, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar Grid.Column="1" Height="7" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                               Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBrush}"
                               BorderThickness="0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right">
                    <Run Text="{Binding Percent, Mode=OneWay}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="角色反复用到的说法" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,10,0,2"
                       Visibility="{Binding HasRepeatedPhrases, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding RepeatedPhrases}"
                          Visibility="{Binding HasRepeatedPhrases, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource NeutralBgBrush}" CornerRadius="8" Padding="7,4" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Phrase}" FontSize="12"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="4,0,0,0">
                      <Run Text="×"/><Run Text="{Binding Messages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="→规则" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="5,0" Margin="6,0,0,0"
                            Command="{Binding DataContext.CreateRewriteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="建一条文案脚本，之后模型写出的这个词会被自动去掉" AutomationProperties.Name="Create rewrite rule"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>
     </StackPanel>
    </Grid>
    <WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
     <CheckBox Content="Current conversation only" IsChecked="{Binding SearchOnlyCurrentConversation}" Margin="2,0,16,0" VerticalAlignment="Center"/>
     <CheckBox Content="Pinned messages only" IsChecked="{Binding SearchPinnedOnly}" Margin="0,0,16,0" VerticalAlignment="Center"/>
     <Button Content="Search" Command="{Binding SearchMessagesCommand}" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="0,0,8,0"/>
     <Button Content="Clear search" Command="{Binding ClearSearchCommand}" Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="0"/>
    </WrapPanel>
    <ItemsControl Grid.Row="2" ItemsSource="{Binding SpeakerFilters}" Margin="0,12,0,0"
                  Visibility="{Binding HasSpeakerFilters, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding Label}" Margin="0,0,6,0" Padding="10,4" FontSize="12"
                ToolTip="只看某个角色说过的内容"
                Command="{Binding DataContext.SelectSpeakerFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
              <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentTintBorderBrush}"/>
                  <Setter Property="Foreground" Value="{DynamicResource AccentTintTextBrush}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
       </Grid>
      </StackPanel>
     </ScrollViewer>
    </Expander>
   </Grid>
  </Border>
  <!-- Conversation stream -->
  <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Margin="8,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid>
   <Image Source="{DynamicResource ThemePaperTexture}" Stretch="Fill" Opacity="{DynamicResource ThemeChatTextureOpacity}" IsHitTestVisible="False"/>
   <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,16" IsHitTestVisible="False">
    <Grid.Style>
     <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
    </Grid.Style>
    <StackPanel HorizontalAlignment="Center">
     <Border x:Name="EmptyBrandTile" Width="80" Height="80" Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,18">
      <Image Width="46" Height="46" Source="{StaticResource BrandIcon}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Lorehaven"/>
     </Border>
     <TextBlock Text="今天想聊些什么？" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
     <TextBlock Text="选择角色或直接输入消息，开始一段新的对话" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
     <Border x:Name="EmptyFeatureRibbon" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15,9" Margin="0,20,0,0" HorizontalAlignment="Center">
      <TextBlock Text="Roleplay · World building · Shared stories" FontSize="11" Foreground="{DynamicResource AccentTintTextBrush}"/>
     </Border>
    </StackPanel>
   </Grid>
   <Border Panel.ZIndex="5" Background="{DynamicResource WarningSoftBgBrush}" BorderBrush="{DynamicResource WarningSoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="24,16" VerticalAlignment="Top" MaxWidth="900"
           Visibility="{Binding HasProviderConfiguration, Converter={StaticResource InverseBoolToVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="Open settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
     <StackPanel><TextBlock Text="Connect a model to start chatting" FontWeight="SemiBold"/><TextBlock Text="Configure a local or cloud provider in Settings." Foreground="{DynamicResource WarningTextBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
   </Border>
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Conversation messages"
                 Padding="18,20,18,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1,2"
                 VirtualizingPanel.CacheLengthUnit="Page">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="22,0,22,16"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding EntryLabel}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border x:Name="MessageBubble" Padding="0" CornerRadius="12" BorderThickness="0">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="AssistantAvatarColumn" Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="UserAvatarColumn" Width="0"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Avatar" Width="44" VerticalAlignment="Top">
         <Grid Width="44" Height="44">
          <Ellipse x:Name="AvatarBackground" Fill="{DynamicResource TealTintBgBrush}"/>
          <Ellipse x:Name="CharacterAvatar" Visibility="{Binding HasCustomAssistantAvatar, Converter={StaticResource BoolToVisibility}}">
           <Ellipse.Fill><ImageBrush ImageSource="{Binding AssistantAvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <TextBlock x:Name="AvatarLetter" Text="{Binding RoleLabel, Converter={StaticResource InitialsConverter}}" Foreground="{DynamicResource TealTintTextBrush}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
         <Button x:Name="CharacterStatusButton" Content="状态" Tag="{Binding}" Click="CharacterStatus_OnClick"
                 Padding="3,2" Margin="0,5,0,0" FontSize="10"
                 ToolTip="查看 AI 生成的角色状态" AutomationProperties.Name="查看角色状态">
          <Button.Style>
           <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
               <Condition Binding="{Binding HasCharacterStatusTarget}" Value="True"/>
               <Condition Binding="{Binding DataContext.IsCharacterStatusPluginEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
             </MultiDataTrigger>
            </Style.Triggers>
           </Style>
          </Button.Style>
         </Button>
        </StackPanel>
        <Border x:Name="MessageContent" Grid.Column="1" Margin="12,0,0,0" Background="{DynamicResource NeutralBgBrush}" CornerRadius="12" Padding="16,12"><StackPanel>
         <DockPanel Margin="0,1,0,8">
          <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayTime}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AccentDeepTextBrush}"/>
         </DockPanel>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Height="24" VerticalAlignment="Center"
                      Visibility="{Binding IsWaitingForResponse, Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="正在思考" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBlock Text="●  ●  ●" Foreground="{DynamicResource AccentBrush}" FontSize="9" VerticalAlignment="Center">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Opacity" Value="0.25"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsWaitingForResponse}" Value="True">
                <DataTrigger.EnterActions>
                 <BeginStoryboard x:Name="WaitingPulse">
                  <Storyboard RepeatBehavior="Forever">
                   <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.65" AutoReverse="True"/>
                  </Storyboard>
                 </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="WaitingPulse"/></DataTrigger.ExitActions>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </StackPanel>
          <controls:MarkdownViewer Markdown="{Binding Content}" FontSize="16"/>
          <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" Margin="0,11,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Height="128" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource PanelBrush}" Margin="0,0,8,8"><Image Source="{Binding FilePath}" Stretch="UniformToFill" ToolTip="{Binding FileName}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,8,0,0">
           <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, ElementName=MessageBubble}" Value="True"/><Condition Binding="{Binding IsStreaming}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/><Condition Binding="{Binding IsStreaming}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
           </Style.Triggers></Style></WrapPanel.Style>
           <Button Content="Copy" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="CopyMessage_OnClick"/>
           <Button Content="{Binding PinnedGlyph}" Style="{StaticResource MessageActionButtonStyle}"
                   Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                   ToolTip="Pin this message" AutomationProperties.Name="Pin message"/>
           <Button Content="Edit" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Delete" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="DeleteMessage_OnClick"/>
           <Button Content="Branch" Style="{StaticResource MessageActionButtonStyle}"
                   Command="{Binding DataContext.BranchFromMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                   ToolTip="Create a new conversation from this message"/>
           <StackPanel Orientation="Horizontal" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Regenerate" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="续写" Style="{StaticResource MessageActionButtonStyle}"
                    Command="{Binding DataContext.ContinueLastReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="让角色接着这条回复写下去，原来的版本仍可向左翻回" AutomationProperties.Name="Continue reply"/>
            <Button Content="‹" Style="{StaticResource MessageActionButtonStyle}" IsEnabled="{Binding CanSwipeLeft}" Command="{Binding DataContext.SwipeLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Previous variation"/>
            <TextBlock Text="{Binding SwipeDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="2,0,7,0"/>
            <Button Content="›" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.SwipeRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Next variation"/>
           </StackPanel>
          </WrapPanel>
         </StackPanel>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
          <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinWidth="100" MinHeight="88" MaxHeight="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
           <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </StackPanel>
        </StackPanel></Border>
       </Grid>
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="MaxWidth" Value="880"/><Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
           <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MaxWidth" Value="650"/>
           <Setter Property="BorderBrush" Value="{DynamicResource ClayTintBorderBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding HasCustomAssistantAvatar}" Value="True">
        <Setter TargetName="AvatarLetter" Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
       <Setter TargetName="AssistantAvatarColumn" Property="Width" Value="0"/>
        <Setter TargetName="UserAvatarColumn" Property="Width" Value="52"/>
        <Setter TargetName="Avatar" Property="Grid.Column" Value="2"/>
        <Setter TargetName="MessageContent" Property="Margin" Value="0,0,12,0"/>
        <Setter TargetName="MessageContent" Property="Background" Value="{DynamicResource ClayTintBgBrush}"/>
        <Setter TargetName="AvatarBackground" Property="Fill" Value="{DynamicResource ClayBrush}"/>
        <Setter TargetName="AvatarLetter" Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
        <Setter TargetName="AvatarLetter" Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  </Border>
  <!-- Story composer -->
  <Grid x:Name="ComposerArea" Grid.Row="2" Margin="24,8,24,16">
   <Grid MaxWidth="880" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource DangerSoftBgBrush}" BorderBrush="{DynamicResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" AutomationProperties.LiveSetting="Assertive">
     <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,0,0,9">
     <Border Background="{DynamicResource TealTintBgBrush}" BorderBrush="{DynamicResource TealTintBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding GroupPerformanceStatus, Converter={StaticResource StringToVisibility}}">
      <StackPanel><TextBlock Text="{Binding GroupPerformanceStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TealTintTextBrush}"/>
       <WrapPanel Margin="0,6,0,0">
        <Button Content="Pause performance" Command="{Binding PauseGroupPerformanceCommand}" Padding="9,4" FontSize="11" Margin="0,0,6,0" Visibility="{Binding IsGroupPerformanceRunning, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="Resume performance" Command="{Binding ResumeGroupPerformanceCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="9,4" FontSize="11" Margin="0,0,6,0" Visibility="{Binding IsGroupPerformancePaused, Converter={StaticResource BoolToVisibility}}"/>
        <Button Content="End performance" Command="{Binding StopGroupPerformanceCommand}" Padding="9,4" FontSize="11" Visibility="{Binding IsGroupPerformanceActive, Converter={StaticResource BoolToVisibility}}"/>
       </WrapPanel>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource AccentTintBgBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10"
             Visibility="{Binding HasReplySuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBlock Text="✦ 你可以这样回应" Foreground="{DynamicResource AccentTintTextBrush}" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,8"/>
       <ItemsControl ItemsSource="{Binding ReplySuggestions}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.SelectReplySuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" Padding="11,8" Margin="0,0,8,6"
                 MaxWidth="245" HorizontalContentAlignment="Left" ToolTip="点击填入输入框">
         <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
         </Button>
        </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
     <Border Background="{DynamicResource NeutralBgBrush}" CornerRadius="12" Padding="12,8"
             Visibility="{Binding IsGeneratingSuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
       <ProgressBar Width="42" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Text="正在根据剧情准备 3 个回复选项…" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border x:Name="ComposerCard" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,11,14,10">
     <Border.Effect><DropShadowEffect Color="{DynamicResource ComposerShadowColor}" BlurRadius="14" ShadowDepth="2" Opacity="0.06"/></Border.Effect>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,0,0,7" Visibility="{Binding HasQueuedSends, Converter={StaticResource BoolToVisibility}}">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="⏳ 排队待发送" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        <Button Content="清空" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="6,0" Margin="8,0,0,0" Command="{Binding ClearQueuedSendsCommand}" ToolTip="取消全部排队消息"/>
       </StackPanel>
       <ItemsControl ItemsSource="{Binding QueuedSends}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource NeutralBgBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Preview}" MaxWidth="260" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.CancelQueuedSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="取消这条排队消息"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingImagePaths}" Margin="2,0,0,7">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource NeutralBgBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="2">
       <TextBox x:Name="ComposerInputBox" Style="{StaticResource ComposerTextBoxStyle}" Padding="9,7" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_OnPreviewKeyDown" AllowDrop="True" Drop="InputBox_OnDrop" ToolTip="Message Lorehaven · Enter to send · Shift+Enter for new line" AutomationProperties.Name="Message input"/>
       <TextBlock Text="Write your reply, or add a new turn to the story…" Foreground="{DynamicResource MutedTextBrush}" FontSize="15" Margin="9,7" VerticalAlignment="Top" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding InputText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ComposerInputBox}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Grid Grid.Row="3" Margin="0,6,0,0">
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="&#xE723;" Style="{StaticResource ConversationIconStyle}" Width="32" Height="32" Background="{DynamicResource NeutralBgBrush}" BorderThickness="0" Click="AttachImage_OnClick" ToolTip="Attach image" AutomationProperties.Name="Attach image"/>
        <TextBlock x:Name="ComposerKeyboardHint" Text="Enter to send · Shift+Enter for a new line" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="&#xE71A;" Style="{StaticResource ConversationIconStyle}" Width="34" Height="34" FontSize="13" Background="{DynamicResource NeutralBorderBrush}" BorderThickness="0" Command="{Binding StopCommand}" Margin="0,0,8,0" ToolTip="Stop" AutomationProperties.Name="Stop generation"/>
        <Button Content="&#xE724;" Style="{StaticResource ConversationIconStyle}" Width="56" Height="36" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0" Command="{Binding SendCommand}" ToolTip="Send" AutomationProperties.Name="Send message"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <TextBlock Grid.Row="3" Text="Lorehaven can make mistakes. Check important information." TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
   </Grid>
  </Grid>

  </Grid>
  <Border x:Name="NotesPanel" Grid.Column="1" Margin="0,10,10,12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Panel.ZIndex="15" ClipToBounds="True">
   <Grid>
    <Image x:Name="NotesArtwork" Source="{DynamicResource ThemeNotesArtwork}" Stretch="Uniform" VerticalAlignment="Bottom" Opacity="{DynamicResource ThemeNotesOpacity}" IsHitTestVisible="False">
     <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#00000000"/><GradientStop Offset="0.4" Color="#00000000"/><GradientStop Offset="0.72" Color="#BB000000"/><GradientStop Offset="1" Color="#FF000000"/></LinearGradientBrush></Image.OpacityMask>
    </Image>
    <Grid Margin="18,20,18,16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,18">
      <Button x:Name="NotesCloseButton" Content="&#xE711;" Click="ToggleNotes_OnClick" DockPanel.Dock="Right" Style="{StaticResource ConversationIconStyle}" Width="26" Height="26" ToolTip="Close notes"/>
      <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21" Foreground="{DynamicResource ClayBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock Text="Story notes" FontFamily="{DynamicResource JournalTitleFontFamily}" FontSize="23" FontWeight="Bold"/>
     </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
        <TextBlock Text="Current branch" FontSize="14" FontWeight="SemiBold"/>
       </Border>
       <ItemsControl ItemsSource="{Binding JournalBranches}" IsEnabled="{Binding CanModifyConversation}" Margin="0,12,0,4">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.OpenJournalBranchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButtonStyle}" HorizontalContentAlignment="Stretch" Padding="3,8" Margin="0,0,0,2" ToolTip="{Binding Title}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border CornerRadius="8" Width="14" Height="14" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{DynamicResource ClayBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ClayBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
           </Border>
           <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ClayTintTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
          </Grid>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="View branch tree" Click="ConversationBranches_OnClick" Style="{StaticResource GhostButtonStyle}" FontSize="11" HorizontalAlignment="Left" Padding="2,5" Margin="0,2,0,18"/>
       <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
        <TextBlock Text="Character memory" FontSize="14" FontWeight="SemiBold"/>
       </Border>
       <ListBox ItemsSource="{Binding MemoryCharacters}" SelectedItem="{Binding SelectedMemoryCharacter}" Background="Transparent" BorderThickness="0" Margin="0,12,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Memory character">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,0,3,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTintTextBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" MaxWidth="165" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Text="No memories yet. Important details will stay here." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,12" Visibility="{Binding HasMemories, Converter={StaticResource InverseBoolToVisibility}}"/>
       <ItemsControl ItemsSource="{Binding CharacterMemories}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,11" Margin="0,0,0,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource ClayBrush}" Margin="0,1,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8A5;"/><Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Text" Value="&#xE72E;"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap" LineHeight="19" FontSize="12" MaxHeight="95" ToolTip="{Binding Content}"/>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="Edit / lock memories" Click="ManageMemories_OnClick" FontSize="11" HorizontalAlignment="Left" Padding="9,6" Margin="0,5,0,8" Visibility="{Binding HasMemoryTarget, Converter={StaticResource BoolToVisibility}}"/>
       <TextBlock Text="{Binding MemoryStatus}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
       <Border Height="220" IsHitTestVisible="False"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
