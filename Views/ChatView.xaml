<UserControl x:Class="NativeTavern.Views.ChatView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:NativeTavern.Controls"
 xmlns:models="clr-namespace:NativeTavern.Models">
 <UserControl.Resources>
  <Style x:Key="MessageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
   <Setter Property="Background" Value="{StaticResource NeutralBgBrush}"/>
   <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
 </UserControl.Resources>
 <Grid x:Name="ChatLayout" Background="{StaticResource WindowBrush}" SizeChanged="ChatLayout_OnSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Compact conversation header -->
  <Border x:Name="ConversationHeader" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18,24,14" Background="{StaticResource PanelBrush}">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
     <DockPanel LastChildFill="True" HorizontalAlignment="Left" MaxWidth="430">
      <Button DockPanel.Dock="Right" Content="✎" Click="RenameChat_OnClick" Style="{StaticResource GhostButtonStyle}" Padding="5,1" Margin="5,0,0,0"
              ToolTip="Rename conversation" AutomationProperties.Name="Rename conversation"/>
      <TextBlock Text="{Binding SessionTitle}" FontSize="18" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <WrapPanel Margin="0,3,0,0">
      <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="Local workspace" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
      <TextBlock Text="  ·  ~" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text="{Binding EstimatedPromptTokens}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text=" tokens" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
      <TextBlock Text="  ·  Branch" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                 Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisibility}}"/>
      <Button Content="返回源对话" Command="{Binding OpenParentConversationCommand}" Style="{StaticResource GhostButtonStyle}"
              Padding="5,0" Margin="5,0,0,0" FontSize="11" AutomationProperties.Name="Open source conversation"
              Visibility="{Binding IsBranch, Converter={StaticResource BoolToVisibility}}"/>
     </WrapPanel>
    </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="⚙" Click="PromptSettings_OnClick" Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,6,0" ToolTip="对话设置" AutomationProperties.Name="对话设置"/>
      <Button Content="＋" Style="{StaticResource RoundIconButtonStyle}" Command="{Binding NewChatCommand}" Margin="0,0,6,0" ToolTip="New chat" AutomationProperties.Name="New conversation"/>
      <Button Content="⋯" Style="{StaticResource RoundIconButtonStyle}" Click="ConversationMore_OnClick" ToolTip="更多操作" AutomationProperties.Name="更多对话操作">
       <Button.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
         <MenuItem Header="查看提示词" Command="{Binding OpenPromptInspectorCommand}"/>
         <MenuItem Header="导出对话…" Click="ExportChat_OnClick"/>
         <Separator/>
         <MenuItem Header="删除对话…" Click="DeleteChat_OnClick"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="📌" Margin="0,0,8,0" Command="{Binding ToggleSessionPinCommand}"
              ToolTip="Pin this conversation" AutomationProperties.Name="Pin conversation">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource RoundIconButtonStyle}">
            <Setter Property="Opacity" Value="0.45"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCurrentSessionPinned}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="100" Height="36" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                DisplayMemberPath="PickerText" Margin="0,0,8,0" ToolTip="Switch conversation" AutomationProperties.Name="Switch conversation">
        <ComboBox.ItemContainerStyle>
          <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding PickerLabel}"/>
          </Style>
        </ComboBox.ItemContainerStyle>
      </ComboBox>
      <Grid Grid.Column="2" Height="36" Margin="0,0,12,0">
      <TextBox x:Name="ConversationSearchBox" VerticalContentAlignment="Center"
               Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_OnKeyDown"
               ToolTip="Search every conversation · Enter to search" AutomationProperties.Name="Search conversations" AutomationProperties.HelpText="Type at least two characters and press Enter"/>
      <TextBlock Text="搜索所有对话" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" IsHitTestVisible="False"
                 VerticalAlignment="Center" Margin="9,1,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SearchQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      </Grid>
      <Popup PlacementTarget="{Binding ElementName=ConversationSearchBox}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="0"
             IsOpen="{Binding IsSearchOpen}" StaysOpen="False" Closed="SearchPopup_OnClosed">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="6" MinWidth="420" MaxWidth="480" Margin="0,4,0,0">
          <StackPanel>
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Style="{StaticResource GhostButtonStyle}" MaxWidth="460" HorizontalContentAlignment="Left"
                          Padding="10,8" Margin="0,1" ToolTip="{Binding Snippet}"
                          AutomationProperties.Name="{Binding Label}"
                          Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Speaker}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10"
                                 Margin="0,1,0,0" Visibility="{Binding Speaker, Converter={StaticResource StringToVisibility}}"/>
                      <TextBlock Text="{Binding Snippet}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                 TextWrapping="Wrap" MaxHeight="42" LineHeight="16"/>
                    </StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="No matching messages" Foreground="{StaticResource MutedTextBrush}" Margin="10,8"
                       Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBoolToVisibility}}"/>
          </StackPanel>
        </Border>
      </Popup>
     <StackPanel Grid.Column="3" Orientation="Horizontal">
     <Button x:Name="PinnedListButton" Content="★" Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,8,0"
             Command="{Binding OpenPinnedListCommand}" IsEnabled="{Binding HasPinnedMessages}"
             ToolTip="Pinned messages" AutomationProperties.Name="Pinned messages"/>
      <Popup PlacementTarget="{Binding ElementName=PinnedListButton}" Placement="Bottom" AllowsTransparency="True"
             IsOpen="{Binding IsPinnedListOpen}" StaysOpen="False" Closed="PinnedPopup_OnClosed">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="6" MinWidth="380" MaxWidth="460" Margin="0,4,0,0">
          <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PinnedMessages}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource GhostButtonStyle}" MaxWidth="440" HorizontalContentAlignment="Left"
                        Padding="10,8" Margin="0,1" AutomationProperties.Name="{Binding EntryLabel}"
                        Command="{Binding DataContext.JumpToPinnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Content}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               TextWrapping="Wrap" MaxHeight="42" LineHeight="16"/>
                  </StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Popup>
     <Button x:Name="StorySummaryButton" Content="❖" Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,8,0"
             Command="{Binding OpenStorySummaryCommand}" ToolTip="Story summary" AutomationProperties.Name="Story summary"/>
      <Popup PlacementTarget="{Binding ElementName=StorySummaryButton}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="-300"
             IsOpen="{Binding IsStorySummaryOpen}" StaysOpen="False" Closed="StorySummaryPopup_OnClosed">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="12" Width="440" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock Text="剧情回顾" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="{Binding StorySummaryCoverage}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,2,0,8"/>
            <TextBox Height="190" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="12" Text="{Binding StorySummary, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Story summary text"
                     ToolTip="这段回顾会随每次请求发送给模型，可直接修改"/>
            <TextBlock Text="{Binding StorySummaryStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="清空" Command="{Binding ClearStorySummaryCommand}"/>
              <Button Content="重新生成" Command="{Binding RebuildStorySummaryCommand}" Margin="8,0,0,0"/>
              <Button Content="保存回顾" Command="{Binding SaveStorySummaryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>
     <Button x:Name="MemoryButton" Content="🧠" Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,8,0"
             Command="{Binding OpenMemoryCommand}" ToolTip="Character memory" AutomationProperties.Name="Character memory"
             Visibility="{Binding HasMemoryTarget, Converter={StaticResource BoolToVisibility}}"/>
     <Popup PlacementTarget="{Binding ElementName=MemoryButton}" Placement="Bottom" AllowsTransparency="True"
            HorizontalOffset="-300"
            IsOpen="{Binding IsMemoryOpen}" StaysOpen="False" Closed="MemoryPopup_OnClosed">
       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
               CornerRadius="10" Padding="12" Width="440" Margin="0,4,0,0">
         <StackPanel>
           <TextBlock Text="角色记忆" FontWeight="SemiBold" FontSize="13"/>
           <TextBlock Text="角色长期记住的要点，会随每次请求发送；在设置中开启后自动提炼" Foreground="{StaticResource SubtleTextBrush}"
                      FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
           <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
             <ItemsControl ItemsSource="{Binding CharacterMemories}">
               <ItemsControl.ItemTemplate><DataTemplate>
                 <Grid Margin="0,2">
                   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                   <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                   <Button Grid.Column="1" Content="×" Style="{StaticResource GhostButtonStyle}" Padding="6,0" Margin="8,0,0,0"
                           Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           CommandParameter="{Binding}" ToolTip="删除这条记忆" AutomationProperties.Name="Delete memory"/>
                 </Grid>
               </DataTemplate></ItemsControl.ItemTemplate>
             </ItemsControl>
           </ScrollViewer>
           <TextBlock Text="No memories yet" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="2,6"
                      Visibility="{Binding HasMemories, Converter={StaticResource InverseBoolToVisibility}}"/>
           <TextBox Height="36" Margin="0,10,0,0" Text="{Binding NewMemoryText, UpdateSourceTrigger=PropertyChanged}"
                    VerticalContentAlignment="Center" ToolTip="Add a memory manually" AutomationProperties.Name="New memory"/>
           <TextBlock Text="{Binding MemoryStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                      TextWrapping="Wrap" Margin="0,6,0,0"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
             <Button Content="立即提炼" Command="{Binding ExtractMemoryNowCommand}" IsEnabled="{Binding CanExtractMemory}"/>
             <Button Content="添加" Command="{Binding AddMemoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
           </StackPanel>
         </StackPanel>
       </Border>
     </Popup>
     <Button x:Name="StatsButton" Content="📊" Style="{StaticResource RoundIconButtonStyle}" Margin="0,0,8,0"
             Command="{Binding OpenStatsCommand}" ToolTip="Conversation stats" AutomationProperties.Name="Conversation stats"/>
      <Popup PlacementTarget="{Binding ElementName=StatsButton}" Placement="Bottom" AllowsTransparency="True"
             HorizontalOffset="-300"
             IsOpen="{Binding IsStatsOpen}" StaysOpen="False">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14" Width="360" Margin="0,4,0,0">
          <StackPanel>
            <TextBlock Text="对话统计" FontWeight="SemiBold" FontSize="13"/>
            <ItemsControl ItemsSource="{Binding StatLines}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="发言占比" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,2"
                       Visibility="{Binding HasSpeakerShares, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding SpeakerShares}"
                          Visibility="{Binding HasSpeakerShares, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar Grid.Column="1" Height="7" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                               Foreground="{StaticResource AccentBrush}" Background="{StaticResource CardBrush}"
                               BorderThickness="0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right">
                    <Run Text="{Binding Percent, Mode=OneWay}"/><Run Text="%"/>
                  </TextBlock>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="角色反复用到的说法" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,2"
                       Visibility="{Binding HasRepeatedPhrases, Converter={StaticResource BoolToVisibility}}"/>
            <ItemsControl ItemsSource="{Binding RepeatedPhrases}"
                          Visibility="{Binding HasRepeatedPhrases, Converter={StaticResource BoolToVisibility}}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="{StaticResource NeutralBgBrush}" CornerRadius="8" Padding="7,4" Margin="0,0,6,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Phrase}" FontSize="12"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="4,0,0,0">
                      <Run Text="×"/><Run Text="{Binding Messages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="→规则" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="5,0" Margin="6,0,0,0"
                            Command="{Binding DataContext.CreateRewriteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="建一条文案脚本，之后模型写出的这个词会被自动去掉" AutomationProperties.Name="Create rewrite rule"/>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Popup>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}">
      <Button Content="成员" Click="EditGroupChat_OnClick" Margin="0,0,8,0" ToolTip="管理群聊成员"
              Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
      <Button Content="下一位 ▾" Click="NextSpeaker_OnClick" Margin="0,0,8,0" ToolTip="自动选择或指定下一位发言角色"
              Visibility="{Binding IsGroupChat, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
    <ItemsControl Grid.Row="3" ItemsSource="{Binding SpeakerFilters}" Margin="0,12,0,0"
                  Visibility="{Binding HasSpeakerFilters, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding Label}" Margin="0,0,6,0" Padding="10,4" FontSize="12"
                ToolTip="只看某个角色说过的内容"
                Command="{Binding DataContext.SelectSpeakerFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
              <Setter Property="Background" Value="{StaticResource CardBrush}"/>
              <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter Property="Background" Value="{StaticResource AccentTintBgBrush}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource AccentTintBorderBrush}"/>
                  <Setter Property="Foreground" Value="{StaticResource AccentTintTextBrush}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Grid>
  </Border>

  <!-- Conversation stream -->
  <Grid Grid.Row="1">
   <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,16" IsHitTestVisible="False">
    <Grid.Style>
     <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
    </Grid.Style>
    <StackPanel HorizontalAlignment="Center">
     <Image Width="48" Height="48" Source="{StaticResource BrandIcon}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,18" AutomationProperties.Name="NativeTavern"/>
     <TextBlock Text="今天想聊些什么？" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
     <TextBlock Text="选择角色或直接输入消息，开始一段新的对话" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
   <Border Panel.ZIndex="5" Background="{StaticResource WarningSoftBgBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="24,16" VerticalAlignment="Top" MaxWidth="900"
           Visibility="{Binding HasProviderConfiguration, Converter={StaticResource InverseBoolToVisibility}}">
    <DockPanel><Button DockPanel.Dock="Right" Content="Open settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0"/>
     <StackPanel><TextBlock Text="Connect a model to start chatting" FontWeight="SemiBold"/><TextBlock Text="Configure a local or cloud provider in Settings." Foreground="{StaticResource WarningTextBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel></DockPanel>
   </Border>
        <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
                 AutomationProperties.Name="Conversation messages"
                 Padding="0,20,0,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 VirtualizingPanel.CacheLength="1,2"
                 VirtualizingPanel.CacheLengthUnit="Page">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="20,0,20,22"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding EntryLabel}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border x:Name="MessageBubble" Padding="16,13" CornerRadius="18" MaxWidth="880">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Avatar" Width="44" VerticalAlignment="Top">
         <Grid Width="44" Height="44">
          <Ellipse x:Name="AvatarBackground" Fill="Transparent"/>
          <Ellipse x:Name="CharacterAvatar" Visibility="{Binding HasAssistantAvatar, Converter={StaticResource BoolToVisibility}}">
           <Ellipse.Fill><ImageBrush ImageSource="{Binding AssistantAvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill>
          </Ellipse>
          <Image x:Name="AssistantBrandIcon" Source="{StaticResource BrandIcon}" Stretch="Uniform" AutomationProperties.Name="NativeTavern"/>
          <TextBlock x:Name="AvatarLetter" Visibility="Collapsed" Text="Y" Foreground="{StaticResource OnAccentBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
         <Button x:Name="CharacterStatusButton" Content="状态" Tag="{Binding}" Click="CharacterStatus_OnClick"
                 Padding="3,2" Margin="0,5,0,0" FontSize="10"
                 ToolTip="查看 AI 生成的角色状态" AutomationProperties.Name="查看角色状态">
          <Button.Style>
           <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
               <Condition Binding="{Binding HasCharacterStatusTarget}" Value="True"/>
               <Condition Binding="{Binding DataContext.IsCharacterStatusPluginEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible"/>
             </MultiDataTrigger>
            </Style.Triggers>
           </Style>
          </Button.Style>
         </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
         <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,7"/>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel Orientation="Horizontal" Height="24" VerticalAlignment="Center"
                      Visibility="{Binding IsWaitingForResponse, Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="正在思考" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBlock Text="●  ●  ●" Foreground="{StaticResource AccentBrush}" FontSize="9" VerticalAlignment="Center">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Opacity" Value="0.25"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsWaitingForResponse}" Value="True">
                <DataTrigger.EnterActions>
                 <BeginStoryboard x:Name="WaitingPulse">
                  <Storyboard RepeatBehavior="Forever">
                   <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:0.65" AutoReverse="True"/>
                  </Storyboard>
                 </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="WaitingPulse"/></DataTrigger.ExitActions>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </StackPanel>
          <controls:MarkdownViewer Markdown="{Binding Content}" FontSize="15"/>
          <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" Margin="0,11,0,0">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border Width="190" Height="128" CornerRadius="10" ClipToBounds="True" Background="{StaticResource PanelBrush}" Margin="0,0,8,8"><Image Source="{Binding FilePath}" Stretch="UniformToFill" ToolTip="{Binding FileName}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource InverseBoolToVisibility}}">
           <Button Content="Copy" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="CopyMessage_OnClick"/>
           <Button Content="{Binding PinnedGlyph}" Style="{StaticResource MessageActionButtonStyle}"
                   Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                   ToolTip="Pin this message" AutomationProperties.Name="Pin message"/>
           <Button Content="Edit" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Delete" Style="{StaticResource MessageActionButtonStyle}" Tag="{Binding}" Click="DeleteMessage_OnClick"/>
           <Button Content="Branch" Style="{StaticResource MessageActionButtonStyle}"
                   Command="{Binding DataContext.BranchFromMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                   ToolTip="Create a new conversation from this message"/>
           <StackPanel Orientation="Horizontal" Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Regenerate" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
            <Button Content="续写" Style="{StaticResource MessageActionButtonStyle}"
                    Command="{Binding DataContext.ContinueLastReplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="让角色接着这条回复写下去，原来的版本仍可向左翻回" AutomationProperties.Name="Continue reply"/>
            <Button Content="‹" Style="{StaticResource MessageActionButtonStyle}" IsEnabled="{Binding CanSwipeLeft}" Command="{Binding DataContext.SwipeLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Previous variation"/>
            <TextBlock Text="{Binding SwipeDisplay}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="2,0,7,0"/>
            <Button Content="›" Style="{StaticResource MessageActionButtonStyle}" Command="{Binding DataContext.SwipeRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Next variation"/>
           </StackPanel>
          </StackPanel>
         </StackPanel>
         <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
          <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinWidth="380" MinHeight="88" MaxHeight="220" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
           <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
           <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          </StackPanel>
         </StackPanel>
        </StackPanel>
       </Grid>
       <Border.Style>
        <Style TargetType="Border">
         <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
           <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{StaticResource CardBrush}"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding HasAssistantAvatar}" Value="True">
        <Setter TargetName="AssistantBrandIcon" Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding Role}" Value="{x:Static models:ChatRole.User}">
       <Setter TargetName="AvatarBackground" Property="Fill" Value="{StaticResource NeutralBorderBrush}"/>
        <Setter TargetName="AvatarLetter" Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter TargetName="AssistantBrandIcon" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="AvatarLetter" Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>

  <!-- Floating GPT-style composer -->
  <Grid x:Name="ComposerArea" Grid.Row="2" Margin="24,8,24,16">
   <Grid MaxWidth="880" HorizontalAlignment="Stretch">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource DangerSoftBgBrush}" BorderBrush="{StaticResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" AutomationProperties.LiveSetting="Assertive">
     <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,0,0,9">
     <Border Background="{StaticResource AccentTintBgBrush}" BorderBrush="{StaticResource AccentTintBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10"
             Visibility="{Binding HasReplySuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
       <TextBlock Text="✦ 你可以这样回应" Foreground="{StaticResource AccentTintTextBrush}" FontWeight="SemiBold" FontSize="12" Margin="2,0,0,8"/>
       <ItemsControl ItemsSource="{Binding ReplySuggestions}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding DataContext.SelectReplySuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentTintBorderBrush}" Padding="11,8" Margin="0,0,8,6"
                 MaxWidth="245" HorizontalContentAlignment="Left" ToolTip="点击填入输入框">
         <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
         </Button>
        </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
     <Border Background="{StaticResource NeutralBgBrush}" CornerRadius="12" Padding="12,8"
             Visibility="{Binding IsGeneratingSuggestions, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
       <ProgressBar Width="42" Height="4" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Text="正在根据剧情准备 3 个回复选项…" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border x:Name="ComposerCard" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="12,10">
     <Border.Effect><DropShadowEffect Color="#525BD4" BlurRadius="18" ShadowDepth="3" Opacity="0.07"/></Border.Effect>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="2,0,0,7" Visibility="{Binding HasQueuedSends, Converter={StaticResource BoolToVisibility}}">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock Text="⏳ 排队待发送" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
        <Button Content="清空" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="6,0" Margin="8,0,0,0" Command="{Binding ClearQueuedSendsCommand}" ToolTip="取消全部排队消息"/>
       </StackPanel>
       <ItemsControl ItemsSource="{Binding QueuedSends}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource NeutralBgBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Preview}" MaxWidth="260" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.CancelQueuedSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="取消这条排队消息"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <ItemsControl Grid.Row="1" ItemsSource="{Binding PendingImagePaths}" Margin="2,0,0,7">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource NeutralBgBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis"/><Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" Margin="6,0,0,0" Command="{Binding DataContext.RemovePendingImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid Grid.Row="2">
       <TextBox x:Name="ComposerInputBox" Style="{StaticResource ComposerTextBoxStyle}" Padding="9,7" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="42" MaxHeight="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_OnPreviewKeyDown" AllowDrop="True" Drop="InputBox_OnDrop" ToolTip="Message NativeTavern · Enter to send · Shift+Enter for new line" AutomationProperties.Name="Message input"/>
       <TextBlock Text="给 NativeTavern 发送消息" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="9,7" VerticalAlignment="Top" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding InputText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=ComposerInputBox}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Grid Grid.Row="3" Margin="0,6,0,0">
       <Button HorizontalAlignment="Left" Content="＋" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="{StaticResource NeutralBgBrush}" BorderThickness="0" Click="AttachImage_OnClick" ToolTip="Attach image" AutomationProperties.Name="Attach image"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="■" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" FontSize="11" Background="{StaticResource NeutralBorderBrush}" BorderThickness="0" Command="{Binding StopCommand}" Margin="0,0,8,0" ToolTip="Stop" AutomationProperties.Name="Stop generation"/>
        <Button Content="↑" Style="{StaticResource RoundIconButtonStyle}" Width="32" Height="32" Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" BorderThickness="0" Command="{Binding SendCommand}" ToolTip="Send" AutomationProperties.Name="Send message"/>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
    <TextBlock Grid.Row="3" Text="NativeTavern can make mistakes. Check important information." TextWrapping="Wrap" TextAlignment="Center" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
