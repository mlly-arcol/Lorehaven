<UserControl x:Class="NativeTavern.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="SettingsTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia, Cambria, SimSun"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="SettingsDescription" TargetType="TextBlock" BasedOn="{StaticResource PageSubtitleStyle}"><Setter Property="Margin" Value="0,4,0,18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SettingsLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Style>
  <Style x:Key="SettingsHeadingIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="19"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Width" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SettingsSection" TargetType="Border" BasedOn="{StaticResource SurfaceBorderStyle}">
   <Setter Property="Padding" Value="22"/>
   <Setter Property="Visibility" Value="Collapsed"/>
  </Style>
  <Style x:Key="InterfaceSectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="interface"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ConnectionSectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="connection"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="GenerationSectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="generation"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="PrivacySectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="privacy"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="LocalModelsSectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="local-models"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="BackupSectionStyle" TargetType="Border" BasedOn="{StaticResource SettingsSection}"><Style.Triggers><DataTrigger Binding="{Binding SelectedSettingsSection.Code}" Value="backup"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SettingsNavigationItem" TargetType="ListBoxItem">
   <Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Padding" Value="14,10"/>
   <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Frame" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentTintBgBrush}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/><Setter TargetName="Frame" Property="Padding" Value="13,9"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ThemePreviewItem" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Frame" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentTintBgBrush}"/></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2"/><Setter TargetName="Frame" Property="Padding" Value="2"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <DataTemplate x:Key="ThemePreviewTemplate">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="Preview" Background="#262138" CornerRadius="7" Padding="14,10">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="49">
       <Border x:Name="BookOne" Width="12" Height="45" Background="#A48BC5" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
       <Border x:Name="BookTwo" Width="15" Height="34" Background="#78648E" CornerRadius="2" Margin="0,0,4,0" VerticalAlignment="Bottom"/>
       <Border x:Name="BookThree" Width="10" Height="49" Background="#CBA96A" CornerRadius="2" VerticalAlignment="Bottom"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
       <TextBlock x:Name="PreviewStar" Text="✦ · ✧" Foreground="#E6C786" FontSize="20" HorizontalAlignment="Right"/>
       <TextBlock x:Name="PreviewBrand" Text="Lorehaven" Foreground="#F0E5D7" FontFamily="Georgia, Cambria, SimSun" FontSize="13" Margin="10,6,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Margin="10,9,10,10">
     <DockPanel>
      <TextBlock Text="✓" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="8,0,0,0">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
     </DockPanel>
     <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Code}" Value="harbor">
     <Setter TargetName="Preview" Property="Background" Value="#F3EEE4"/>
     <Setter TargetName="BookOne" Property="Background" Value="#244D47"/>
     <Setter TargetName="BookTwo" Property="Background" Value="#77917C"/>
     <Setter TargetName="BookThree" Property="Background" Value="#B85D36"/>
     <Setter TargetName="PreviewStar" Property="Foreground" Value="#6F856E"/>
     <Setter TargetName="PreviewBrand" Property="Foreground" Value="#244D47"/>
    </DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="30,26,30,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource TealBrush}" BorderThickness="2,0,0,0" Padding="15,0,0,0" Margin="0,0,0,18">
  <StackPanel>
   <TextBlock Text="WORKSPACE PREFERENCES" Style="{StaticResource PageKickerStyle}" Margin="0,0,0,5"/>
   <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
   <TextBlock Text="Configure model connections, generation behavior and context privacy." Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0"/>
  </StackPanel>
  </Border>
  <ListBox x:Name="SectionNavigation" Grid.Row="1" ItemsSource="{Binding SettingsSections}"
           SelectedItem="{Binding SelectedSettingsSection,Mode=TwoWay}" ItemContainerStyle="{StaticResource SettingsNavigationItem}"
           Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
           KeyboardNavigation.TabNavigation="Once" AutomationProperties.Name="Settings sections">
   <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,12,18">
   <Grid MaxWidth="1120" VerticalAlignment="Top">
    <Border x:Name="InterfaceSection" Style="{StaticResource InterfaceSectionStyle}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.ColumnSpan="2" Background="{DynamicResource AccentTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE790;" Style="{StaticResource SettingsHeadingIcon}"/><TextBlock Text="Interface" Style="{StaticResource SettingsTitle}"/></DockPanel></Border>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Choose your language, theme and color mode." Style="{StaticResource SettingsDescription}"/>
      <TextBlock Grid.Row="2" Text="Interface Language" Style="{StaticResource SettingsLabel}"/>
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="3" Text="Color mode" Style="{StaticResource SettingsLabel}"/>
      <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="DisplayName"/>
      <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,20,0,0">
       <TextBlock Text="Theme" Style="{StaticResource SettingsLabel}" Margin="0,0,0,9"/>
       <ListBox ItemsSource="{Binding ThemeStyles}" SelectedItem="{Binding SelectedThemeStyle,Mode=TwoWay}"
                ItemContainerStyle="{StaticResource ThemePreviewItem}" ItemTemplate="{StaticResource ThemePreviewTemplate}"
                Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                AutomationProperties.Name="Theme">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       </ListBox>
       <TextBlock Text="Themes and color mode apply immediately and are saved automatically."
                  Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,2"/>
      </StackPanel>
      <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Enable global hotkeys" IsChecked="{Binding HotkeysEnabled}" Margin="2,14,0,4"
                ToolTip="System-wide shortcuts work even when Lorehaven is not focused."/>
      <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Hotkeys need a modifier such as Ctrl or Alt, e.g. Ctrl+Alt+T. Keys already owned by other apps are skipped."
                 Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,10"/>
      <TextBlock Grid.Row="7" Text="Show / hide hotkey" Style="{StaticResource SettingsLabel}"/>
      <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ToggleWindowHotkey,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="8" Text="Boss key (hide to tray)" Style="{StaticResource SettingsLabel}"/>
      <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding BossKeyHotkey,UpdateSourceTrigger=PropertyChanged}"/>
     </Grid>
    </Border>
    <Border x:Name="ConnectionSection" Style="{StaticResource ConnectionSectionStyle}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Grid.ColumnSpan="2" Background="{DynamicResource AccentTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE968;" Style="{StaticResource SettingsHeadingIcon}"/><TextBlock Text="Provider connection" Style="{StaticResource SettingsTitle}"/></DockPanel></Border>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Connect to an OpenAI-compatible, cloud or local model service." Style="{StaticResource SettingsDescription}"/>
      <TextBlock Grid.Row="2" Text="Provider" Style="{StaticResource SettingsLabel}"/>
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ProviderProfiles}" SelectedItem="{Binding SelectedProvider}" DisplayMemberPath="DisplayName" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="3" Text="Base URL" Style="{StaticResource SettingsLabel}"/>
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BaseUrl,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
      <TextBlock Grid.Row="4" Text="API Key" Style="{StaticResource SettingsLabel}"/>
      <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged"/>
       <Button Grid.Column="1" Content="Clear" Command="{Binding ClearApiKeyCommand}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Grid.Row="5" Text="Model" Style="{StaticResource SettingsLabel}"/>
      <Grid Grid.Row="5" Grid.Column="1">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox IsEditable="True" ItemsSource="{Binding AvailableModels}" DisplayMemberPath="Id" TextSearch.TextPath="Id" Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Grid.Column="1" Content="Discover Models" Command="{Binding DiscoverModelsCommand}" Margin="8,0,0,0"/>
      </Grid>
     </Grid>
    </Border>
    <Border x:Name="GenerationSection" Style="{StaticResource GenerationSectionStyle}">
     <StackPanel>
      <Border Background="{DynamicResource AccentTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE9E9;" Style="{StaticResource SettingsHeadingIcon}"/><TextBlock Text="Generation" Style="{StaticResource SettingsTitle}"/></DockPanel></Border>
      <TextBlock Text="Tune response creativity and request size." Style="{StaticResource SettingsDescription}"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Temperature" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="1" Text="{Binding Temperature,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,12" ToolTip="0 to 2"/>
       <TextBlock Grid.Column="2" Text="Top P" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="3" Text="{Binding TopP,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" ToolTip="0 to 1"/>
       <TextBlock Grid.Row="1" Text="Max Tokens" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxTokens,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,18,0" ToolTip="Greater than 0"/>
       <TextBlock Grid.Row="1" Grid.Column="2" Text="Context Length" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ContextLength,UpdateSourceTrigger=PropertyChanged}" ToolTip="Reference context window; local server context size is configured by the server"/>
       <CheckBox Grid.Row="2" Grid.ColumnSpan="4" IsChecked="{Binding TrimHistoryToContext}" Margin="2,14,0,0" ToolTip="Newest messages are always kept; short chats are never cut">
        <TextBlock Text="Trim the oldest turns when a request would exceed the context window" TextWrapping="Wrap"/>
       </CheckBox>
      </Grid>
      <Grid Margin="0,16,0,0" IsEnabled="{Binding IsLlamaCppProvider}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Local thinking mode" Style="{StaticResource SettingsLabel}"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding ThinkingModes}" SelectedItem="{Binding SelectedThinkingMode}" DisplayMemberPath="DisplayName"/>
       <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="For llama.cpp models with switchable thinking, such as Qwen3.5. Quick reply skips thinking; deep thinking may take longer and use more response tokens. Save to apply."
                  Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border x:Name="PrivacySection" Style="{StaticResource PrivacySectionStyle}">
     <StackPanel>
      <Border Background="{DynamicResource TealTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE72E;" Style="{StaticResource SettingsHeadingIcon}" Foreground="{DynamicResource TealTintTextBrush}"/><TextBlock Text="Context privacy" Style="{StaticResource SettingsTitle}" Foreground="{DynamicResource TealTintTextBrush}"/></DockPanel></Border>
      <TextBlock Text="Choose which local content may be included in model requests." Style="{StaticResource SettingsDescription}"/>
      <CheckBox IsChecked="{Binding IncludeCharacterContext}" Margin="2,0,0,15"><TextBlock Text="Include the selected character card and First Message in model requests" TextWrapping="Wrap"/></CheckBox>
      <CheckBox IsChecked="{Binding IncludeKnowledgeContext}" Margin="2,0,0,15"><TextBlock Text="Allow matched knowledge-base excerpts to be sent in model requests" TextWrapping="Wrap"/></CheckBox>
      <CheckBox IsChecked="{Binding IncludeImageContext}" Margin="2,0,0,15"><TextBlock Text="Allow attached images to be sent in model requests" TextWrapping="Wrap"/></CheckBox>
      <CheckBox IsChecked="{Binding CharacterMemoryEnabled}" Margin="2,0,0,0" ToolTip="Long-term facts the character remembers; view and edit them from the chat header">
       <TextBlock Text="Distill character memory from chats and include it in model requests" TextWrapping="Wrap"/>
      </CheckBox>
     </StackPanel>
    </Border>
    <Border x:Name="BackupSection" Style="{StaticResource BackupSectionStyle}">
     <StackPanel>
      <Border Background="{DynamicResource AccentTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE896;" Style="{StaticResource SettingsHeadingIcon}"/><TextBlock Text="Data backup" Style="{StaticResource SettingsTitle}"/></DockPanel></Border>
      <TextBlock Text="Back up or restore characters, chats, settings, avatars, attachments and knowledge files." Style="{StaticResource SettingsDescription}"/>
      <WrapPanel>
       <Button Content="Create backup" Click="Backup_OnClick" Margin="0,0,8,8"/>
       <Button Content="Restore backup" Click="Restore_OnClick" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border x:Name="LocalModelsSection" Style="{StaticResource LocalModelsSectionStyle}">
     <StackPanel>
      <Border Background="{DynamicResource AccentTintBgBrush}" CornerRadius="10" Padding="12,10"><DockPanel><TextBlock Text="&#xE950;" Style="{StaticResource SettingsHeadingIcon}"/><TextBlock Text="Local model runtime" Style="{StaticResource SettingsTitle}"/></DockPanel></Border>
      <TextBlock Text="Discover running services or start a GGUF model with llama.cpp." Style="{StaticResource SettingsDescription}"/>
      <CheckBox Content="Scan local services at startup" IsChecked="{Binding AutoScanLocalModels}" Margin="2,0,0,16"/>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Model folder" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="1" Text="{Binding LocalModelDirectory,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
       <Button Grid.Column="2" Content="Browse" Click="BrowseModelDirectory_OnClick" Margin="8,0,0,12"/>
       <TextBlock Grid.Row="1" Text="llama.cpp executable" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LlamaCppPath,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseLlamaCpp_OnClick" Margin="8,0,0,0"/>
      </Grid>
      <Button Content="Refresh model files" Command="{Binding RefreshModelFilesCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="GPU layers" Style="{StaticResource SettingsLabel}"/>
       <TextBox Grid.Column="1" Text="{Binding LocalGpuLayers,UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <TextBlock Text="0 uses CPU only; lower the layer count if GPU memory runs out. Changes apply the next time you start a model."
                 Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"/>
      <TextBlock Text="{Binding LocalModelStatus}" TextWrapping="Wrap" Margin="2,0,0,12"/>
      <TextBlock Text="GGUF model files" FontWeight="SemiBold" Margin="2,0,0,7"/>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedLocalModel}" DisplayMemberPath="DisplayName">
        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
         <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
        </Style.Triggers></Style></ComboBox.Style>
       </ComboBox>
       <Button Grid.Column="1" Content="Start and Connect" Command="{Binding StartSelectedLocalModelCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
       <Button Grid.Column="2" Content="Stop model" Command="{Binding StopLocalModelCommand}" IsEnabled="{Binding LocalModel.IsRunning}" Margin="8,0,0,0"/>
      </Grid>
      <Expander Header="Startup diagnostics" Margin="2,0,0,16">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="Recent output from the model service. Check this when a model fails to start." TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" Margin="0,0,0,8"/>
        <TextBox Text="{Binding LocalModel.LastDiagnostics,Mode=OneWay}" IsReadOnly="True" MaxHeight="180" MinHeight="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Button Content="Copy diagnostics" Click="CopyModelDiagnostics_OnClick" IsEnabled="{Binding LocalModel.HasDiagnostics}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
       </StackPanel>
      </Expander>
      <TextBlock Text="Running local services" FontWeight="SemiBold" Margin="2,0,0,7"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding DetectedServices}" SelectedItem="{Binding SelectedDetectedService}" DisplayMemberPath="DisplayName"/>
       <Button Grid.Column="1" Content="Scan Local" Command="{Binding ScanLocalCommand}" Margin="8,0,8,0"/>
       <Button Grid.Column="2" Content="Use Selected" Command="{Binding UseDetectedServiceCommand}" Margin="0"/>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="3" Background="{DynamicResource NeutralBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14">
   <Grid>
    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,220,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/>
     <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
