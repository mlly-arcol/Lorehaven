<Window x:Class="NativeTavern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NativeTavern"
        Title="NativeTavern" Icon="/NativeTavern;component/Assets/NativeTavern.png" Height="820" Width="1280" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Opacity="0"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" AllowDrop="True" Drop="Window_OnDrop">
    <Grid x:Name="RootLayout" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="StartupScale" ScaleX="0.985" ScaleY="0.985"/>
                <TranslateTransform x:Name="StartupTranslate" Y="10"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="8,4,8,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="30" Height="30" Source="{StaticResource BrandIcon}" Stretch="Uniform" AutomationProperties.Name="NativeTavern" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NativeTavern" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Local AI workspace" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <Button Style="{StaticResource NavButtonStyle}" Command="{Binding NewChatCommand}" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="＋" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="New chat" VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+N" FontSize="9" Foreground="{StaticResource SubtleTextBrush}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" Margin="12,6,0,6" />
                    <Button Content="◉   Chat" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding Chat}" Command="{Binding ShowChatCommand}" />
                    <Button Content="♙   Characters" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding Characters}" Command="{Binding ShowCharactersCommand}" />
                    <Button Content="⌁   Prompt Studio" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding PromptStudio}" Command="{Binding ShowPromptStudioCommand}" />
                    <Button Content="▤   Knowledge Base" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding Knowledge}" Command="{Binding ShowKnowledgeCommand}" />
                    <Button Content="⌕   Prompt Inspector" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding PromptInspector}" Command="{Binding ShowPromptInspectorCommand}" />
                    <Button Content="⬡   Plugins" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding Plugins}" Command="{Binding ShowPluginsCommand}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="6,8" />
                    <Button Content="⚙   Settings" Style="{StaticResource SelectedNavButtonStyle}" Tag="{Binding Settings}" Command="{Binding ShowSettingsCommand}" />
                    <Grid Margin="12,9,12,5">
                        <TextBlock Text="NativeTavern" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{x:Static local:App.DisplayVersion}" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
